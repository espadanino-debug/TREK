# Copy to .env.local and fill in. Never commit real keys.

# Public URL of the site (no trailing slash), e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" (legacy) or "publishable" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" (legacy) or "secret" key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Image generation
# openai | fal | replicate (only openai is implemented)
AI_PROVIDER=openai
AI_API_KEY=
# Optional OpenAI tuning
AI_MODEL=gpt-image-1
# low | medium | high (higher = better, slower and costs more)
AI_IMAGE_QUALITY=medium
# Optional: OpenAI key for the free moderation API when AI_PROVIDER is not openai
OPENAI_MODERATION_KEY=

# Payments (Phase 2)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=

# Google Search Console verification code (content of the meta tag)
GOOGLE_SITE_VERIFICATION=

# Plausible Analytics: your site domain as added in Plausible, e.g. example.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: custom script URL if Plausible gave you a site-specific one
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=

# Random long string. Protects /api/cron/cleanup (Vercel Cron sends it automatically)
CRON_SECRET=
# Random long string used to hash visitor IPs for the free-page limit
IP_HASH_SALT=
